package spec

import (
	"fmt"
	"net/url"
	"os"
	"path"
	"path/filepath"
	"runtime"
	"strings"
)

// normalizePaths returns the absolute path of refPath, given a base absolute path and a ref path.
//
// 1) if refPath is absolute, return it
// 2) if refPath is relative, join it with basePath keeping the scheme, hosts, and ports if exists
//
// base may be a directory or a fully qualified file path
//
// base or refPath may be a file path or a URL
func normalizePaths(refPath, base string) string {
	debugLog("normalizedPaths for: %s, base: %s", refPath, base)
	refPath, _ = url.PathUnescape(refPath)
	refPath = filepath.ToSlash(refPath)
	refURL, _ := url.Parse(refPath)

	if path.IsAbs(refURL.Path) || filepath.IsAbs(refPath) {
		// refPath is actually absolute
		if refURL.Host != "" {
			debugLog("normalizedPaths#0: %s", refPath)
			return refPath
		}
		refPath = normalizedAbsPath(refPath)
		parts := strings.Split(refPath, "#")
		result := filepath.FromSlash(parts[0])
		if len(parts) == 2 {
			result += "#" + parts[1]
		}
		debugLog("normalizedPaths#1: %s", result)
		return result
	}

	// relative refPath
	base, _ = url.PathUnescape(base)
	base = filepath.ToSlash(base)
	baseURL, _ := url.Parse(base)
	if !strings.HasPrefix(refPath, "#") {
		// combining paths
		if baseURL.Host != "" {
			baseURL.Path = path.Join(path.Dir(baseURL.Path), refURL.Path)
		} else { // base is a file
			newBase := fmt.Sprintf("%s#%s", path.Join(path.Dir(base), refURL.Path), refURL.Fragment)
			debugLog("normalizedPaths#2: %s", newBase)
			return newBase
		}
	}

	// copying fragment from ref to base
	baseURL.Fragment = refURL.Fragment
	debugLog("normalizedPaths#3: %s", baseURL.String())
	return baseURL.String()
}

// denormalizePaths returns to simplest notation on file $ref,
// i.e. strips the absolute path and sets a path relative to the base path.
//
// relativeBase is the document containing the ref
// originalRelativeBase is the root document original specified, so we want to rebase everything relative to that one
//
// This is currently used when we rewrite ref after a circular ref has been detected
func denormalizeFileRef(ref *Ref, relativeBase, originalRelativeBase string) *Ref {
	debugLog("denormalizeFileRef for %s based on %s and %s", ref.String(), relativeBase, originalRelativeBase)
	relativeBase = normalizedAbsPath(relativeBase) // TODO: normally not needed

	if ref == nil {
		return nil
	}

	// already local no need to denormalize
	if ref.String() == "" || isRefLocal(*ref) {
		return ref
	}

	// strip relativeBase from URI
	relativeBaseURL, _ := url.Parse(relativeBase)
	relativeBaseURL.Fragment = ""

	// remote URIS on different hosts
	//
	originalRelativeBaseURL, _ := url.Parse(originalRelativeBase)
	originalRelativeBaseURL.Fragment = ""
	if relativeBaseURL.Host != originalRelativeBaseURL.Host {
		return ref
	}

	// relative file URIs
	//
	debugLog("denormalizeFileRef(2) %s - %s", ref.String(), originalRelativeBaseURL.String())

	if strings.HasPrefix(ref.String(), originalRelativeBaseURL.String()) {
		// the resulting ref is in the expanded spec: return a local ref
		r, _ := NewRef(strings.TrimPrefix(ref.String(), originalRelativeBaseURL.String()))
		return &r
	}

	// check if we may set a relative path, considering the original base path for this spec.
	// Example:
	//   spec is located at /mypath/spec.json
	//   my normalized ref points to: /mypath/item.json#/target
	//   expected result: item.json#/target

	var originalPath string
	//pth, _ := url.PathUnescape(originalRelativeBaseURL.Path) // TODO: check if needed
	pth := originalRelativeBaseURL.Path

	if originalRelativeBaseURL.Host != "" {
		originalPath = path.Dir(pth)
	} else {
		originalPath = filepath.Dir(pth)
	}
	originalRelativeBaseURL.Path = originalPath

	if strings.HasPrefix(ref.String(), originalRelativeBaseURL.String()) {
		r, _ := NewRef(strings.TrimPrefix(ref.String(), originalRelativeBaseURL.String()))
		return &r
	}

	/*
		parts := strings.Split(ref.String(), "#")
		relativePath, err := filepath.Rel(originalPath, parts[0])
		if err != nil {
			// there is no common ancestor (e.g. different drives on windows)
			// leaves the ref unchanged
			return ref
		}
		if len(parts) > 1 {
			relativePath += "#" + parts[1]
		}
		r, _ := NewRef(relativePath)
	*/
	return ref
}

// normalizeFileRef returns a normalized file reference for local files.
//
// relativeBase could be an ABSOLUTE file path or an ABSOLUTE URL
func normalizeFileRef(ref *Ref, relativeBase string) *Ref {
	// this is important for when the reference is pointing to the root schema
	if ref.String() == "" {
		r, _ := NewRef(relativeBase)
		return &r
	}

	debugLog("normalizing %s against %s", ref.String(), relativeBase)

	s := normalizePaths(ref.String(), relativeBase)
	r, _ := NewRef(s)
	debugLog("normalizedFileRef: %s", ref.String())
	return &r
}

// normalizedAbsPath returns a normalized absolute path for cache
//
// local file system directories are prepended with "file://" to get legit URIs.
func normalizedAbsPath(pth string) string {
	if strings.HasPrefix(pth, "http") || strings.HasPrefix(pth, "file://") {
		// does not change fully qualified URI
		return pth
	}

	if !filepath.IsAbs(pth) {
		wd, _ := os.Getwd()
		return "file://" + filepath.Join(wd, pth)
	}

	if runtime.GOOS == "windows" {
		// on Windows, drive letters should be converted to lower case
		u, _ := url.Parse(pth)
		pth = u.String()
	}
	return "file://" + pth
}
